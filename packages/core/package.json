{
  "name": "@ziweijs/core",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js and TypeScript bindings for the ziwei Rust engine",
  "license": "MIT",
  "files": [
    "dist",
    "native",
    "index.mjs",
    "README.md"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build:native": "napi build --manifest-path ../../crates/ziwei_napi/Cargo.toml --package ziwei-napi --platform --release --output-dir native --js binding.cjs --dts binding.d.cts -- --locked",
    "build:ts": "tsc --project tsconfig.json",
    "build": "pnpm run build:native && pnpm run build:ts",
    "bench": "node bench/run.mjs",
    "bench:smoke": "node bench/run.mjs --smoke",
    "test:bench": "node --test bench/bench.test.mjs",
    "test": "node --test test/*.test.mjs",
    "test:types": "tsc --project test/tsconfig.json"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.9.0",
    "typescript": "7.0.2"
  },
  "napi": {
    "binaryName": "ziwei-native",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
